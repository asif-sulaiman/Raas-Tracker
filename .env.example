# RAAS Tracker Environment Configuration
# Copy to .env and fill in values for production deployment.

# REQUIRED: PostgreSQL connection string (Supabase session pooler).
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Percent-encode special characters in the password (+ -> %2B, & -> %26, @ -> %40).
DATABASE_URL=

# Database for the test suite (defaults to a local raas_test database).
# Point at a scratch database, never at production: tests wipe and rebuild it.
TEST_DATABASE_URL=

# REQUIRED in production: secret key for the application.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RAAS_SECRET=

# Set to "1" to enable production mode (requires RAAS_SECRET).
PRODUCTION=0

# Host and port (default: 127.0.0.1:5000 for dev, 0.0.0.0:5000 for prod)
HOST=127.0.0.1
PORT=5000

# Set to "1" to enable HSTS + HTTPS redirect.
FORCE_HTTPS=0

# Cookie security: "1" (default) sends cookies only over HTTPS.
# Set to "0" only for local development without HTTPS.
COOKIE_SECURE=1

# Comma-separated CORS origins (empty = same-origin only, recommended).
# Needed only for separately-hosted frontends or cross-origin API clients.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Set to "1" to enable Flask debug mode (dev only, NEVER in production).
FLASK_DEBUG=0

# Set to "true" to disable the /setup endpoint after initial admin creation.
DISABLE_SETUP=false

# CRON_SECRET: Secret token for the daily maturity check cron endpoint.
# Required for the /api/cron/maturity-check endpoint (Vercel cron job).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# Flask environment: "production" or "development"
FLASK_ENV=development

# Rate limiting storage (Flask-Limiter).
# REQUIRED in multi-process/serverless production (Vercel, gunicorn/waitress with
# >1 worker): without it, limits are counted per process and a client can exceed
# them by that many times. Optional for single-process local dev (in-memory).
# Example: REDIS_URL=redis://localhost:6379/0
# REDIS_URL=

# Database connection pool max size (default: 10)
# DB_POOL_MAX=10

# Upload body cap in megabytes (default: 50; floats allowed).
# On Vercel the platform body limit is 4.5MB and is enforced at the edge before
# Flask, so set this to 4.5 to keep the app's own 413 JSON aligned with it.
# MAX_CONTENT_LENGTH_MB=50
