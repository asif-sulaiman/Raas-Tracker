# ChemCalc Environment Configuration
# Copy to .env and fill in values for production deployment.

# REQUIRED in production: secret key for the application.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CHEMCALC_SECRET=

# Set to "1" to enable production mode (requires CHEMCALC_SECRET).
PRODUCTION=0

# Host and port (default: 127.0.0.1:5000 for dev, 0.0.0.0:5000 for prod)
HOST=127.0.0.1
PORT=5000

# Set to "1" to enable HSTS + HTTPS redirect.
FORCE_HTTPS=0

# Cookie security: "1" (default) sends cookies only over HTTPS.
# Set to "0" only for local development without HTTPS.
COOKIE_SECURE=1

# Set to "1" to enable Flask debug mode (dev only, NEVER in production).
FLASK_DEBUG=0

# Set to "true" to disable the /setup endpoint after initial admin creation.
DISABLE_SETUP=false

# Flask environment: "production" or "development"
FLASK_ENV=development
